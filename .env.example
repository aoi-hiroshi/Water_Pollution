WATER_SERVER_HOST=0.0.0.0
WATER_SERVER_PORT=8080
WATER_IO_THREADS=2

WATER_DB_HOST=127.0.0.1
WATER_DB_PORT=3306
WATER_DB_USER=water_app
WATER_DB_PASSWORD=change-me
WATER_DB_NAME=Water_Quality_System
WATER_DB_POOL_MIN=2
WATER_DB_POOL_MAX=8
WATER_DB_QUEUE_CAPACITY=512

# Exported and parity-checked Random Forest graph. Leave unset to disable trace.
WATER_TRACE_MODEL_PATH=./server/models/trace_random_forest.onnx
WATER_TRACE_MODEL_NAME=random_forest
WATER_TRACE_MODEL_VERSION=1.0
WATER_TRACE_LABEL_OFFSET=1
# Verified prediction graph is included. Leave unset to disable forecast.
WATER_FORECAST_MODEL_PATH=./server/models/forecast_attention_lstm_h10.onnx
WATER_ONNX_INTRA_OP_THREADS=1
WATER_INFERENCE_CORE_THREADS=1
WATER_INFERENCE_MAX_THREADS=2
WATER_INFERENCE_QUEUE_CAPACITY=128

# Classification data analysis has its own small bounded CPU pool.
WATER_ANALYSIS_THREADS=1
WATER_ANALYSIS_QUEUE_CAPACITY=4

# Used by the Windows Qt client. Set this to the Linux VM address.
WATER_API_BASE_URL=http://127.0.0.1:8080
